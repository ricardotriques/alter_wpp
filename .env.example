# Copie para .env e ajuste. No alwaysdata, configure estas variáveis no próprio Service
# (Avançado > Serviços > Ambiente) ou deixe o arquivo .env na pasta do projeto.

# PostgreSQL da conta alwaysdata
# Se a senha tiver caracteres especiais, codifique: @ -> %40   $ -> %24   # -> %23   : -> %3A   / -> %2F
DATABASE_URL=postgres://USUARIO:SENHA@postgresql-CONTA.alwaysdata.net:5432/CONTA_waengine

# Endereço e porta:
# - Site Node.js do alwaysdata (plano Free): NÃO defina HOST/PORT, a plataforma informa sozinha.
# - Service (planos pagos) ou outro servidor: descomente as linhas abaixo.
# HOST=::
# PORT=8300

# Chave mestra para as rotas /admin (gere com: openssl rand -hex 32)
MASTER_KEY=troque-por-uma-chave-longa-e-aleatoria

# URL pública (site Reverse proxy apontando para o serviço)
PUBLIC_URL=https://CONTA.alwaysdata.net

# Intervalo entre envios por linha (anti-banimento), em milissegundos
SEND_MIN_DELAY_MS=1500
SEND_MAX_DELAY_MS=4000

# Simular "digitando..." antes de mensagens de texto
SIMULATE_TYPING=true

# Dias de retenção das mensagens guardadas (necessárias para mídia e reenvios)
MESSAGE_RETENTION_DAYS=7

# Ignorar mensagens de grupos
IGNORE_GROUPS=true

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
